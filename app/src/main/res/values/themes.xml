<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base (Modo Claro). O sufixo DayNight permite que o
         AppCompatDelegate.setDefaultNightMode alterne para values-night. -->
    <style name="Theme.GuiaInstrumentos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cordas_medio</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorPrimaryContainer">@color/cordas_suave</item>
        <item name="colorOnPrimaryContainer">@color/cordas_escuro</item>
        <item name="colorSecondary">@color/cordas_claro</item>
        <item name="colorOnSecondary">@color/cordas_escuro</item>
        <item name="android:colorBackground">@color/fundo_claro</item>
        <item name="colorSurface">@color/superficie_clara</item>
        <item name="colorOnSurface">@color/texto_claro</item>
        <item name="colorOnSurfaceVariant">@color/texto_claro_fraco</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Variantes de cor escolhidas em Configuracoes (item 2 do enunciado:
         "modificar dinamicamente aspectos de cores ou estilos visuais"). -->
    <style name="Theme.GuiaInstrumentos.Turquesa">
        <item name="colorPrimary">@color/sopro_medio</item>
        <item name="colorPrimaryContainer">@color/sopro_suave</item>
        <item name="colorOnPrimaryContainer">@color/sopro_escuro</item>
        <item name="colorSecondary">@color/sopro_claro</item>
        <item name="colorOnSecondary">@color/sopro_escuro</item>
    </style>

    <style name="Theme.GuiaInstrumentos.Roxo">
        <item name="colorPrimary">@color/perc_medio</item>
        <item name="colorPrimaryContainer">@color/perc_suave</item>
        <item name="colorOnPrimaryContainer">@color/perc_escuro</item>
        <item name="colorSecondary">@color/perc_claro</item>
        <item name="colorOnSecondary">@color/perc_escuro</item>
    </style>

    <style name="TextoTitulo">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextoDescricao">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
